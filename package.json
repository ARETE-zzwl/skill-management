    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "playwright": "^1.60.0",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
