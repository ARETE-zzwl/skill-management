{
  "name": "skill-management",
  "version": "0.1.0",
  "description": "Local-first AI agent skill manager demo for Codex and Claude Code.",
  "type": "module",
  "bin": {
    "skillmgr": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
